# Telegram Bot Token (tạo bot với @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Chat ID để bot gửi thông báo khởi động (nhắn /myid cho bot để lấy)
CHAT_ID=

# Google Sheets
GOOGLE_SHEET_NAME=Chi tiêu gia đình

# Google Service Account Credentials (JSON)
# Cách 1: Dùng file credentials.json trong thư mục project
GOOGLE_CREDENTIALS_FILE=credentials.json

# Cách 2: Dùng biến môi trường (cho deploy)
# GOOGLE_CREDENTIALS_JSON={"type": "service_account", "project_id": "...", ...}
